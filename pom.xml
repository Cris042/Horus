<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.example</groupId>
    <artifactId>horus-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Horus (parent)</name>
    <description>POM parent/agregador do monorepo Horus — propriedades comuns e BOM do Quarkus para os módulos Java.</description>

    <!--
      Build do monorepo Java. Cada módulo Quarkus (hoje: horus; futuramente os serviços de
      domínio) herda Java 25, encoding e o BOM do Quarkus deste parent. Componentes não-Java
      (worker Rust, loadtest Python) têm build próprio fora do Maven.
    -->
    <modules>
        <module>horus</module>
        <module>services/prontuario</module>
        <module>services/payment</module>
        <module>services/invoice</module>
        <module>services/saga-orchestrator</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <maven.compiler.parameters>true</maven.compiler.parameters>

        <!-- Quarkus (ver lib.md §2). 3.37.x é a primeira linha que suportamos sob JDK 25:
             o enhancement de entidades Panache do 3.20.0 usava um ASM anterior ao Java 25
             (falha "Unsupported class file major version 69"). Bump feito em T-101. -->
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.version>3.37.0</quarkus.platform.version>

        <!-- Quarkus LangChain4j (extensão Anthropic/Claude — ADR-0011, T-601).
             Versionada à parte do BOM Quarkus (quarkiverse); confirmar compat ao subir. -->
        <anthropic-java.version>2.65.0</anthropic-java.version>

        <compiler-plugin.version>3.13.0</compiler-plugin.version>
        <surefire-plugin.version>3.5.1</surefire-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
