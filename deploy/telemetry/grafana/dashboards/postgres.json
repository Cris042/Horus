{
  "id": null,
  "uid": "horus-postgres",
  "title": "Horus — Bancos de dados (Postgres)",
  "description": "Métricas dos 4 bancos isolados por serviço (prontuario/payment/invoice/saga) via postgres_exporter: conexões, transações, atividade de linhas, cache hit ratio e tamanho. Para ver o TEXTO das queries SQL (statement parametrizado), use o Jaeger (datasource já provisionado) — spans CLIENT com db.query.text, por serviço.",
  "tags": ["horus", "medrec", "postgres"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Visão geral",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Bancos no ar",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(pg_up)", "legendFormat": "up" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 4 }]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Conexões ativas (total)",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(pg_stat_database_numbackends{datname=~\"prontuario_db|payment_db|invoice_db|saga_db\"})",
          "legendFormat": "conexões"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Transações/s (total)",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(pg_stat_database_xact_commit{datname=~\"prontuario_db|payment_db|invoice_db|saga_db\"}[5m])) + sum(rate(pg_stat_database_xact_rollback{datname=~\"prontuario_db|payment_db|invoice_db|saga_db\"}[5m]))",
          "legendFormat": "tx/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 2 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Tamanho total (4 bancos)",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(pg_database_size_bytes{datname=~\"prontuario_db|payment_db|invoice_db|saga_db\"})",
          "legendFormat": "tamanho"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "decimals": 1 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none" }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Conexões e transações por banco",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Conexões ativas por banco",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(pg_stat_database_numbackends{datname=~\"prontuario_db|payment_db|invoice_db|saga_db\"}) by (datname)",
          "legendFormat": "{{datname}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Transações/s por banco (commit + rollback)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(pg_stat_database_xact_commit{datname=~\"prontuario_db|payment_db|invoice_db|saga_db\"}[5m])) by (datname)",
          "legendFormat": "{{datname}} commit"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(pg_stat_database_xact_rollback{datname=~\"prontuario_db|payment_db|invoice_db|saga_db\"}[5m])) by (datname)",
          "legendFormat": "{{datname}} rollback"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Cache hit ratio por banco",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(pg_stat_database_blks_hit{datname=~\"prontuario_db|payment_db|invoice_db|saga_db\"}[5m])) by (datname) / (sum(rate(pg_stat_database_blks_hit{datname=~\"prontuario_db|payment_db|invoice_db|saga_db\"}[5m])) by (datname) + sum(rate(pg_stat_database_blks_read{datname=~\"prontuario_db|payment_db|invoice_db|saga_db\"}[5m])) by (datname))",
          "legendFormat": "{{datname}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] }
    },
    {
      "id": 20,
      "type": "row",
      "title": "Atividade de linhas (o que está sendo escrito/lido)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Linhas inseridas/s por banco",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(pg_stat_database_tup_inserted{datname=~\"prontuario_db|payment_db|invoice_db|saga_db\"}[5m])) by (datname)",
          "legendFormat": "{{datname}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Linhas atualizadas/deletadas por banco",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(pg_stat_database_tup_updated{datname=~\"prontuario_db|payment_db|invoice_db|saga_db\"}[5m])) by (datname)",
          "legendFormat": "{{datname}} update"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(pg_stat_database_tup_deleted{datname=~\"prontuario_db|payment_db|invoice_db|saga_db\"}[5m])) by (datname)",
          "legendFormat": "{{datname}} delete"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Linhas lidas/s por banco (fetched)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(pg_stat_database_tup_fetched{datname=~\"prontuario_db|payment_db|invoice_db|saga_db\"}[5m])) by (datname)",
          "legendFormat": "{{datname}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 30,
      "type": "row",
      "title": "Tamanho e saúde",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 31,
      "type": "barchart",
      "title": "Tamanho por banco",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "pg_database_size_bytes{datname=~\"prontuario_db|payment_db|invoice_db|saga_db\"}",
          "legendFormat": "{{datname}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Linhas mortas (dead tuples) por tabela — sinal de vacuum",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "pg_stat_user_tables_n_dead_tup",
          "legendFormat": "{{database}} {{relname}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] }
    }
  ]
}
